{
  "name": "dots-and-squares",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "dev:worker": "wrangler dev --port ${WORKER_PORT:-8787}",
    "deploy": "npm run build && wrangler deploy",
    "make-icon": "node scripts/make-icon.mjs && bash scripts/make-app.sh",
    "browser-check": "node scripts/browser-check.mjs",
    "aim-check": "node scripts/aim-check.mjs",
    "lobby-check": "node scripts/lobby-check.mjs",
    "sim": "node scripts/sim-five-players.mjs",
    "check-deployed": "node scripts/check-deployed.mjs",
    "ship": "npm run deploy && npm run check-deployed"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260905.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260911.1": true
  }
}
