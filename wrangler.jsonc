{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dots-and-squares",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this the SPA handler answers /api/* with index.html before the
    // Worker ever sees the request, and the WebSocket upgrade fails obscurely.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "GameRoom" },
      { "name": "LOBBY", "class_name": "LobbyRoom" }
    ]
  },
  // Workers Logs. Without this a bug a real player hits inside a Durable Object
  // leaves no trace anywhere — the room is the only place that knows, and it is
  // gone by the time anyone asks. Sampling at 1 (100%) because this game's whole
  // traffic is a handful of matches; there is nothing here worth sampling down.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // new_sqlite_classes, not new_classes: the free plan only offers the SQLite
  // storage backend, and a new_classes migration is rejected at deploy.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["LobbyRoom"] }
  ]
}
