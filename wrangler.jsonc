{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dots-and-squares",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this the SPA handler answers /api/* with index.html before the
    // Worker ever sees the request, and the WebSocket upgrade fails obscurely.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "GameRoom" },
      { "name": "LOBBY", "class_name": "LobbyRoom" }
    ]
  },
  // new_sqlite_classes, not new_classes: the free plan only offers the SQLite
  // storage backend, and a new_classes migration is rejected at deploy.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["LobbyRoom"] }
  ]
}
